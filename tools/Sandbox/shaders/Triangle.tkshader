// Sandbox triangle, single-source HLSL .tkshader manifest.

Shader "Sandbox/Triangle"
{
    SubShader
    {
        Target
        {
            dx11   = "d3d_sm5"
            dx12   = "dx_sm6"
            vulkan = "vk_sm5"
            opengl = "glsl_410"
        }

        Pass "Forward"
        {
            Cull Off
            ZWrite On
            ZTest LessEqual

            Vertex
            {
                Source = "Triangle.hlsl"
                Entry = "VSMain"
            }

            Pixel
            {
                Source = "Triangle.hlsl"
                Entry = "PSMain"
            }
        }
    }
}
