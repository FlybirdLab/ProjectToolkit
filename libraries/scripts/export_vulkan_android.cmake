cmake_minimum_required(VERSION 3.20)

if(NOT TPKG_ARTIFACT)
    message(FATAL_ERROR "TPKG_ARTIFACT is required")
endif()

set(_ndk "$ENV{ANDROID_NDK_ROOT}")
if(NOT _ndk)
    set(_ndk "$ENV{ANDROID_NDK_HOME}")
endif()
if(NOT _ndk)
    message(FATAL_ERROR
        "Android NDK was not found. Set ANDROID_NDK_ROOT or ANDROID_NDK_HOME.")
endif()
file(TO_CMAKE_PATH "${_ndk}" _ndk)

string(TOLOWER "${TPKG_ARCH}" _arch)
if(_arch MATCHES "^(arm64|aarch64|arm64-v8a)$")
    set(_triple "aarch64-linux-android")
elseif(_arch MATCHES "^(arm|armv7|armeabi-v7a)$")
    set(_triple "arm-linux-androideabi")
elseif(_arch MATCHES "^(x64|x86_64)$")
    set(_triple "x86_64-linux-android")
elseif(_arch STREQUAL "x86")
    set(_triple "i686-linux-android")
else()
    message(FATAL_ERROR "Unsupported Android architecture for Vulkan: ${TPKG_ARCH}")
endif()

set(_sysroot "${_ndk}/toolchains/llvm/prebuilt")
file(GLOB _host_prebuilts LIST_DIRECTORIES true "${_sysroot}/*")
set(_ndk_sysroot "")
foreach(_host IN LISTS _host_prebuilts)
    if(IS_DIRECTORY "${_host}/sysroot/usr/include/vulkan")
        set(_ndk_sysroot "${_host}/sysroot")
        break()
    endif()
endforeach()
if(NOT _ndk_sysroot)
    message(FATAL_ERROR "Vulkan headers were not found in Android NDK: ${_ndk}")
endif()

set(_lib_root "${_ndk_sysroot}/usr/lib/${_triple}")
set(_requested_api "$ENV{ANDROID_API_LEVEL}")
if(NOT _requested_api)
    set(_requested_api "$ENV{ANDROID_PLATFORM}")
endif()
string(REGEX REPLACE "^android-" "" _requested_api "${_requested_api}")

set(_vulkan_lib "")
if(_requested_api AND EXISTS "${_lib_root}/${_requested_api}/libvulkan.so")
    set(_vulkan_lib "${_lib_root}/${_requested_api}/libvulkan.so")
else()
    file(GLOB _api_dirs LIST_DIRECTORIES true "${_lib_root}/*")
    list(SORT _api_dirs COMPARE NATURAL ORDER ASCENDING)
    foreach(_api_dir IN LISTS _api_dirs)
        if(EXISTS "${_api_dir}/libvulkan.so")
            set(_vulkan_lib "${_api_dir}/libvulkan.so")
            break()
        endif()
    endforeach()
endif()
if(NOT _vulkan_lib)
    message(FATAL_ERROR
        "Vulkan loader stub was not found for ${_triple} in Android NDK: ${_ndk}")
endif()

file(REMOVE_RECURSE "${TPKG_ARTIFACT}/include/vulkan")
file(MAKE_DIRECTORY "${TPKG_ARTIFACT}/include" "${TPKG_ARTIFACT}/lib")
file(COPY "${_ndk_sysroot}/usr/include/vulkan"
     DESTINATION "${TPKG_ARTIFACT}/include")
file(COPY_FILE "${_vulkan_lib}"
     "${TPKG_ARTIFACT}/lib/libvulkan.so"
     ONLY_IF_DIFFERENT)

message(STATUS "Exported Android Vulkan SDK from ${_ndk_sysroot} (${_triple})")
